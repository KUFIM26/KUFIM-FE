# Keep browser requests on this frontend origin so session and CSRF cookies work.
VITE_API_BASE_URL=/api/v1
# Vite dev/preview forwards /api and /ws to this backend.
API_PROXY_TARGET=https://32-236-74-117.sslip.io
# Local backend alternative: http://127.0.0.1:8080

# Local/same-origin WebSocket support. Vercel build disables it and keeps REST polling.
VITE_REALTIME_ENABLED=true

# 상황실 연락처 덮어쓰기 (비워두면 기본값 02-450-3990 사용)
VITE_CONTROL_ROOM_PHONE=
