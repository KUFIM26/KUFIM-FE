# Copy to .env.local and adjust. Files ending in .local are not committed.

# mock: in-memory Figma demo data (default). api: use the KUFIM backend.
VITE_DATA_SOURCE=api

# Backend origin for the dev/preview proxy (/api and /ws).
VITE_API_PROXY_TARGET=http://127.0.0.1:8080

# Leave empty to call /api on the same origin. Set only when the API is on the same site
# under another path or host; the admin session cookie is SameSite=Lax.
VITE_API_BASE_URL=
